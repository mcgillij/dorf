#!/usr/bin/env bash
# Stop the bot and STT worker. Empty PID lists are expected when nothing runs.
# Tight patterns anchored to "python ... <script>" so editors/viewers of the
# file (vi derfbot.py, less, etc.) are never matched.
set -uo pipefail

# pgrep matches zombies too, and a zombie never dies by signal — which used
# to wedge kill's wait loop and make startup skip relaunching forever.
live_pids() {
  local pat="$1" p state
  for p in $(pgrep -f "$pat" 2>/dev/null || true); do
    state=$(awk '{print $3}' "/proc/$p/stat" 2>/dev/null)
    [ -n "$state" ] && [ "$state" != "Z" ] && echo "$p"
  done
}

stop_procs() {
  local pattern="$1"
  local pids
  pids=$(live_pids "$pattern")
  if [ -z "$pids" ]; then
    return 0
  fi
  echo "stopping ($pattern): $pids"
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  # Wait up to 10s for a clean exit, then escalate.
  for _ in $(seq 1 20); do
    pids=$(live_pids "$pattern")
    [ -z "$pids" ] && break
    sleep 0.5
  done
  pids=$(live_pids "$pattern")
  if [ -n "$pids" ]; then
    echo "escalating to SIGKILL for: $pids"
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null || true
  fi
}

stop_procs "[p]ython.*derfbot\.py"
stop_procs "[p]ython.*whisper_worker\.py"
# Space after "uvicorn" is deliberate: `uvicorn main:app` (ours) must NOT
# match other services' `uvicorn app.main:app` (a container process is
# visible from the host and matches a looser pattern).
stop_procs "[u]vicorn main:app"

# Orphaned log followers from startup (docker compose/docker logs -f).
pkill -f "[c]ompose logs -f.*redis" 2>/dev/null || true
pkill -f "[d]ocker logs -f.*derf-whisper" 2>/dev/null || true

