#!/usr/bin/env bash
# startup for dependencies
set -uo pipefail

cd "$(dirname "$0")"

# pgrep matches zombies, and a zombie never goes away by signal — which made
# startup skip launching forever after an unclean exit. Ignore zombies.
live_pid() {
  local pat="$1" p state
  for p in $(pgrep -f "$pat" 2>/dev/null || true); do
    state=$(awk '{print $3}' "/proc/$p/stat" 2>/dev/null)
    [ -n "$state" ] && [ "$state" != "Z" ] && { echo "$p"; return 0; }
  done
  return 1
}

# Redis (docker compose: persistent volume + restart policy)
docker compose up -d

# Mirror container logs to files so `just up-logs` can tail everything with
# one process. pgrep guards keep restarts from duplicating the followers.
# setsid + </dev/null: fully detach from the caller's session/pty so a
# harness/tool timeout can't kill the process group, and the caller's
# stdout pipe doesn't stay open forever.
mkdir -p logs
if ! live_pid "[c]ompose logs -f.*redis"; then
  nohup setsid docker compose logs -f --tail 20 redis >> logs/redis.log 2>&1 < /dev/null &
fi
if ! live_pid "[d]ocker logs -f.*derf-whisper"; then
  nohup setsid docker logs -f --tail 20 derf-whisper >> logs/whisper_server.log 2>&1 < /dev/null &
fi

# Whisper STT server (ROCm). Start only if nothing is already listening on 8080.
# One-time model download into ./models:
#   mkdir -p models
#   docker run --rm -v "$PWD/models:/models" ghcr.io/ggerganov/whisper.cpp:main \
#     /bin/sh -c "cd /app/models && ./download-ggml-model.sh base.en && cp ggml-base.en.bin /models/"
if ! curl -s -o /dev/null --max-time 2 http://127.0.0.1:8080/; then
  docker rm -f derf-whisper 2>/dev/null
  # Hardened vs the original: SYS_PTRACE and seccomp=unconfined dropped.
  # --network=host stays: the server binds 127.0.0.1 by default (verified
  # never LAN-reachable), and passing explicit --host/--port makes this
  # build fail to bind ("couldn't bind to server socket"). --ipc=host
  # stays: ROCm fails to allocate GPU memory without it.
  # --restart unless-stopped: a host reboot used to leave STT down while
  # redis (compose) came back on its own.
  docker run -d --name derf-whisper --network=host \
    --restart unless-stopped \
    --device=/dev/kfd --device=/dev/dri --group-add=video --ipc=host \
    -v "$PWD/models:/models" \
    ghcr.io/ggerganov/whisper.cpp@sha256:13d0e7c873c59a262dca621b57ad28de40e9927ac883d936dfd8459142c90db4 \
    /app/build/bin/whisper-server -m /models/ggml-base.en.bin
fi

# dorf api (FastAPI shim the Godot pet talks to). Runs on :8100 — :8000 is
# permanently occupied by the godot-ai MCP server in this environment.
# Guard is a health check, not pgrep: the pattern `uvicorn.*main:app` used
# to match ANOTHER service's `uvicorn app.main:app` (a container process
# visible from the host), which made startup skip launching our api
# forever, and `./kill` even SIGTERMed that foreign process.
if curl -sf http://127.0.0.1:8100/api/health 2>/dev/null | grep -q '"status"'; then
  echo "dorf api already healthy on :8100; skipping launch"
else
  nohup setsid bash -c 'cd ../api && poetry run uvicorn main:app --host 127.0.0.1 --port 8100' \
    >> api.nohup.log 2>&1 < /dev/null &
  echo "started dorf api (pid $!)"
fi

# STT worker (consumes whisper_queue, routes transcripts to the bots).
# Guarded: two workers fight over whisper_queue and the startup reaper
# steals in-flight jobs from a live worker (docs/improvement.md P1-10).
# Anchored to "python ..." like ./kill: an unanchored pattern matches ANY
# process whose cmdline merely contains the script name (an editor viewing
# it, a tail/grep/CI shell wrapper) and silently skips the launch.
if ! live_pid "[p]ython.*whisper_worker\.py"; then
  nohup setsid poetry run python whisper_worker.py >> whisper_worker.nohup.log 2>&1 < /dev/null &
  echo "started whisper_worker (pid $!)"
else
  echo "whisper_worker already running; skipping launch"
fi

# The bot — exactly ONE process. Do not also run a file-watcher variant:
# two processes fight over the Discord token and tear each other's voice
# sinks down. (Anchored pattern: see the worker note above.)
if ! live_pid "[p]ython.*derfbot\.py"; then
  nohup setsid poetry run python derfbot.py >> bot.nohup.log 2>&1 < /dev/null &
  echo "started derfbot (pid $!)"
else
  echo "derfbot already running; skipping launch"
fi
