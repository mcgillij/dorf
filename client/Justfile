# Bootstrap / setup / run tasks for the dorf client stack.
# Docs: docs/modernize_justfile_tasks.md

set shell := ["bash", "-uc"]

# Pinned by digest: the floating :main tag silently changed STT behavior
# once. To bump: docker pull the tag, read `docker image inspect <tag>
# --format '{{json .RepoDigests}}'`, and update this line.
whisper_image := "ghcr.io/ggerganov/whisper.cpp@sha256:13d0e7c873c59a262dca621b57ad28de40e9927ac883d936dfd8459142c90db4"
whisper_model := "models/ggml-base.en.bin"
whisper_container := "derf-whisper"

# List all tasks
@default:
    just --list

# Install python dependencies into the poetry venv
install:
    poetry install

# Reinstall the TTS + torch stack. Poetry can't own these: misaki still
# declares python <3.13, and letting pip resolve kokoro's deps would
# downgrade numpy (breaking pandas) and pull a CUDA torch. The canonical
# installer is scripts/install_kokoro_py313_rocm.sh (system ROCm torch,
# pinned versions, spaCy model, synthesis smoke test) — see also
# README.md and pyproject.toml's tts group comment.
# Runs: bash scripts/install_kokoro_py313_rocm.sh
tts-deps:
    bash scripts/install_kokoro_py313_rocm.sh

# Run the unit test suite
test:
    poetry run python -m pytest tests/ -q

# Run the api contract tests (first time: cd api && poetry install)
test-api:
    cd ../api && poetry run python -m pytest tests/ -q

# Pull redis + whisper.cpp images
pull:
    docker compose pull redis
    docker pull {{whisper_image}}

# Start redis (persistent volume)
redis-up:
    docker compose up -d

# Stop redis
redis-down:
    docker compose down

# One-time: download the whisper model (~148MB) into ./models
@model:
    mkdir -p models
    test -f {{whisper_model}} || \
    docker run --rm -v "$PWD/models:/models" {{whisper_image}} \
      /bin/sh -c "cd /app/models && ./download-ggml-model.sh base.en && cp ggml-base.en.bin /models/"

# Start the whisper.cpp STT server on :8080 (ROCm), only if not already up
@whisper-up:
    if curl -s -o /dev/null --max-time 2 http://127.0.0.1:8080/; then \
      echo "whisper server already listening on :8080"; exit 0; fi
    docker rm -f {{whisper_container}} 2>/dev/null || true
    docker run -d --name {{whisper_container}} --network=host \
      --device=/dev/kfd --device=/dev/dri --group-add=video --ipc=host \
      --cap-add=SYS_PTRACE --security-opt seccomp=unconfined \
      -v "$PWD/models:/models" \
      {{whisper_image}} \
      /app/build/bin/whisper-server -m /models/ggml-base.en.bin

# Stop the whisper.cpp server
@whisper-down:
    docker rm -f {{whisper_container}} 2>/dev/null || true

# Run the whisper worker (STT queue consumer) in the foreground
whisper-worker:
    poetry run python whisper_worker.py

# Run the bot in the foreground (dev; exactly one process)
bot:
    poetry run python derfbot.py

# Run the dorf api (the Godot pet's HTTP shim) in the foreground.
# :8100 — :8000 is taken by the godot-ai MCP server in this environment.
# First time: cd api && poetry install
@api:
    cd ../api && poetry run uvicorn main:app --host 127.0.0.1 --port 8100

# Lint (ruff; same paths as CI)
@lint:
    poetry run ruff check bot/ whisper_worker.py derfbot.py tests/

@lint-fix:
    poetry run ruff check --fix bot/ whisper_worker.py derfbot.py tests/

# Run the bot with auto-restart on *.py changes (dev only; never with `up`)
bot-watch:
    poetry run watchmedo auto-restart -p "*.py" -R python -- derfbot.py

# Start the full stack in the background: redis + whisper server + worker + bot
up:
    ./startup

# Stop everything the stack started
stop:
    ./kill

# Restart the full stack. Returns immediately — it does NOT tail logs (the
# old `tail -f` made `just restart` look hung; follow with `just up-logs`).
restart: stop && up
    @echo "stack restarted. follow with: just up-logs"

# Sanity check the stack: redis, whisper server, model file
@check:
    @echo -n "redis:     "; poetry run python -c "from bot.redis_client import redis_client; print('OK' if redis_client.ping() else 'FAIL')" 2>/dev/null || echo "FAIL"
    @echo -n "whisper :  "; curl -s -o /dev/null --max-time 2 http://127.0.0.1:8080/ && echo "OK (:8080)" || echo "FAIL (:8080)"
    @echo -n "model:     "; test -f {{whisper_model}} && echo "OK" || echo "MISSING (run: just model)"
    @echo -n "bot proc:  "; pgrep -af "[d]erfbot.py" > /dev/null && echo "running" || echo "not running"
    @echo -n "worker:    "; pgrep -af "[w]hisper_worker.py" > /dev/null && echo "running" || echo "not running"
    @echo -n "api:       "; curl -s -o /dev/null --max-time 2 http://127.0.0.1:8100/api/health && echo "OK (:8100)" || echo "FAIL (:8100)"

# Tail the bot log
logs:
    tail -f bot.log

# Tail every stack log at once: redis + whisper server + STT worker + bot.
# Container logs are mirrored to logs/ by `startup`/`up`.
@up-logs:
    mkdir -p logs
    touch logs/redis.log logs/whisper_server.log
    tail -F -n 15 logs/redis.log logs/whisper_server.log whisper_worker.nohup.log bot.log

# Tail the docker-side logs only (redis + whisper server)
@docker-logs:
    mkdir -p logs
    touch logs/redis.log logs/whisper_server.log
    tail -F -n 15 logs/redis.log logs/whisper_server.log

# Tail the background whisper worker log
worker-logs:
    tail -f whisper_worker.nohup.log

# Tail the background bot nohup log
bot-logs:
    tail -f bot.nohup.log

# Opt-in: do NOT enable while ./startup (nohup) is running — systemd
# auto-restart would fight ./kill. Enabling these replaces the nohup
# workflow. Afterwards enable with:
#   systemctl --user enable --now derfbot.service derf-whisper-worker.service
# Install systemd user units (copy + daemon-reload, no enable/start).
@install-services:
    mkdir -p ~/.config/systemd/user
    cp deploy/systemd/derfbot.service deploy/systemd/derf-whisper-worker.service deploy/systemd/dorf-api.service ~/.config/systemd/user/
    systemctl --user daemon-reload
    @echo "installed (not enabled). enable with: systemctl --user enable --now derfbot.service derf-whisper-worker.service dorf-api.service"

# Remove the systemd user units (disable + delete)
@uninstall-services:
    systemctl --user disable --now derfbot.service 2>/dev/null || true
    systemctl --user disable --now derf-whisper-worker.service 2>/dev/null || true
    systemctl --user disable --now dorf-api.service 2>/dev/null || true
    rm -f ~/.config/systemd/user/derfbot.service ~/.config/systemd/user/derf-whisper-worker.service ~/.config/systemd/user/dorf-api.service
    systemctl --user daemon-reload
